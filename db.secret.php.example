<?php
// ============================================================
// db.secret.php — PRODUCTION DATABASE CREDENTIALS
// ============================================================
// Salin file ini menjadi "db.secret.php" di server production
// jika Anda tidak bisa upload file .env secara manual.
//
// PENTING: Jangan commit file "db.secret.php" ke git!
//          File ini sudah di-ignore di .gitignore.
// ============================================================

// Pastikan file ini HANYA diload dari config.php
if (!defined('DB_HOST')) {
    putenv('DB_HOST=localhost');
    putenv('DB_NAME=YOUR_DB_NAME');
    putenv('DB_USER=YOUR_DB_USER');
    putenv('DB_PASS=YOUR_DB_PASS');

    $_ENV['DB_HOST'] = 'localhost';
    $_ENV['DB_NAME'] = 'YOUR_DB_NAME';
    $_ENV['DB_USER'] = 'YOUR_DB_USER';
    $_ENV['DB_PASS'] = 'YOUR_DB_PASS';

    $_SERVER['DB_HOST'] = 'localhost';
    $_SERVER['DB_NAME'] = 'YOUR_DB_NAME';
    $_SERVER['DB_USER'] = 'YOUR_DB_USER';
    $_SERVER['DB_PASS'] = 'YOUR_DB_PASS';
}
